[Unit]
Description=TestOrchestrator application server (Waitress)
After=network.target

[Service]
Type=simple
User=testorchestrator
Group=testorchestrator
# Replaceable application payload:
WorkingDirectory=/opt/testorchestrator
# Persistent configuration/data (instance dir, database, certs) lives in
# /var/lib/testorchestrator and /etc/testorchestrator — never in the payload.
EnvironmentFile=/etc/testorchestrator/web.env
ExecStart=/opt/testorchestrator/venv/bin/waitress-serve \
    --listen=127.0.0.1:8080 \
    --threads=8 \
    wsgi:app
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/testorchestrator

[Install]
WantedBy=multi-user.target
