; TestOrchestrator FULL application installer — Windows amd64
; Complete product: app + embedded Python + Buildbot 4.3.0 runtime
; (master + to-local + to-ssh-dispatcher workers) + the bundled
; remote-worker installer for Admin-UI download. Cheroot terminates
; HTTPS in-process — no external web/proxy component is installed.
; The KRE execution engine is installed/licensed SEPARATELY — not
; redistributed; the installer registers the user's installation.
; UNSIGNED build — labelled clearly.
!define PRODUCT "TestOrchestrator"
!ifndef VERSION
!define VERSION "2.5.1"   ; default only — builds pass -DVERSION=<release.json>
!endif
!define PAYLOAD_DIR "app-payload"

Name "${PRODUCT} ${VERSION} (unsigned)"
OutFile "testorchestrator-${VERSION}-windows-amd64-setup-UNSIGNED.exe"
InstallDir "$PROGRAMFILES64\TestOrchestrator"
RequestExecutionLevel admin
ShowInstDetails show
Var /GLOBAL DATA_DIR
Var /GLOBAL ORCH_PORT
Var /GLOBAL PUBLIC_ADDR
Var /GLOBAL PURGE_DATA

!include "MUI2.nsh"
!define MUI_ICON "it.ico"
!define MUI_UNICON "it.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "wizard.bmp"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "Open TestOrchestrator in your browser"
!define MUI_FINISHPAGE_RUN_FUNCTION OpenPortal
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"
!include "FileFunc.nsh"
!include "LogicLib.nsh"

Section "Install TestOrchestrator" SecMain
    ReadEnvStr $DATA_DIR "ProgramData"
    StrCpy $DATA_DIR "$DATA_DIR\TestOrchestrator"

    ; Reinstall/upgrade: stop the running tasks + reap children before
    ; overwriting locked executables, then drop payload-owned dirs so
    ; stale module files from a previous build cannot linger. Customer
    ; state under $DATA_DIR is never touched here.
    ${If} ${FileExists} "$DATA_DIR\stop_to.cmd"
        nsExec::ExecToLog '"$DATA_DIR\stop_to.cmd"'
        Sleep 1500
    ${EndIf}
    RMDir /r "$INSTDIR\python"
    RMDir /r "$INSTDIR\buildbot-py"
    RMDir /r "$INSTDIR\site-packages"
    RMDir /r "$INSTDIR\testorchestrator"
    RMDir /r "$INSTDIR\migrations"
    RMDir /r "$INSTDIR\scripts"
    RMDir /r "$INSTDIR\deploy"
    RMDir /r "$INSTDIR\3rdparty"
    RMDir /r "$INSTDIR\packaging"
    RMDir /r "$INSTDIR\release"
    Delete "$INSTDIR\wsgi.py"
    Delete "$INSTDIR\run_worker.py"
    Delete "$INSTDIR\requirements.txt"
    Delete "$INSTDIR\uninstall.exe"

    SetOutPath "$INSTDIR"
    File /r "${PAYLOAD_DIR}\*.*"
    File "it.ico"

    CreateDirectory "$DATA_DIR"
    CreateDirectory "$DATA_DIR\instance"
    CreateDirectory "$DATA_DIR\logs"
    CreateDirectory "$DATA_DIR\certs"
    CreateDirectory "$DATA_DIR\home"
    CreateDirectory "$DATA_DIR\buildbot"
    ; private CA key, database/licence state, and buildbot secrets are
    ; not world-readable: strip inherited Users access on those dirs
    nsExec::ExecToLog 'icacls "$DATA_DIR\instance" /inheritance:r /grant:r "SYSTEM:(OI)(CI)F" "Administrators:(OI)(CI)F"'
    nsExec::ExecToLog 'icacls "$DATA_DIR\certs" /inheritance:r /grant:r "SYSTEM:(OI)(CI)F" "Administrators:(OI)(CI)F"'
    nsExec::ExecToLog 'icacls "$DATA_DIR\buildbot" /inheritance:r /grant:r "SYSTEM:(OI)(CI)F" "Administrators:(OI)(CI)F"'

    ${GetOptions} $CMDLINE "/PORT=" $ORCH_PORT
    ${GetOptions} $CMDLINE "/ADDR=" $PUBLIC_ADDR
    ${If} $ORCH_PORT == ""
        StrCpy $ORCH_PORT "8443"
    ${EndIf}
    ${If} $PUBLIC_ADDR == ""
        StrCpy $PUBLIC_ADDR "localhost"
    ${EndIf}

    ; application env — internal component wiring is generated, not
    ; user-configured. The app loads this file itself on Windows
    ; (config.py reads %ProgramData%\TestOrchestrator\testorchestrator.env);
    ; real environment variables still win.
    FileOpen $0 "$DATA_DIR\testorchestrator.env" w
    FileWrite $0 "TO_INSTANCE_DIR=$DATA_DIR\instance$\r$\n"
    FileWrite $0 "TO_DATABASE_URI=sqlite:///$DATA_DIR\instance\to.db$\r$\n"
    FileWrite $0 "TO_PUBLIC_ADDR=$PUBLIC_ADDR$\r$\n"
    FileWrite $0 "TO_SECURE_COOKIES=1$\r$\n"
    FileWrite $0 "TO_HTTPS_PORT=$ORCH_PORT$\r$\n"
    FileWrite $0 "TO_HTTP_PORT=8080$\r$\n"
    FileWrite $0 "TO_CERT_DIR=$DATA_DIR\certs$\r$\n"
    FileWrite $0 "TO_BUILDBOT_ENDPOINT=http://127.0.0.1:8010$\r$\n"
    FileWrite $0 "TO_BUILDBOT_HOME=$DATA_DIR\buildbot$\r$\n"
    FileWrite $0 "TO_BUILDBOT_PIDFILE=$DATA_DIR\buildbot\master\twistd.pid$\r$\n"
    FileWrite $0 "TO_BUILDBOT_PB_PORT=9989$\r$\n"
    FileWrite $0 "TO_BUILDBOT_WWW_PORT=8010$\r$\n"
    FileClose $0
    ; install-unique secrets (session key + install id) — generated by
    ; the embedded interpreter, preserved on rerun. Every install step
    ; tee's into $DATA_DIR\logs\install.log (the details pane is
    ; ephemeral) and is exit-code checked — a provisioning failure must
    ; not produce a silently broken install.
    nsExec::ExecToLog 'cmd /c ""$INSTDIR\python\python.exe" "$INSTDIR\scripts\init_env.py" --env-file "$DATA_DIR\testorchestrator.env" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Environment initialisation failed (code $0) — see $DATA_DIR\logs\install.log"
        Abort "init_env failed"
    ${EndIf}

    ; wire vendored site-packages into both embeddable runtimes —
    ; ._pth entries resolve relative to the python dir
    FileOpen $1 "$INSTDIR\python\python312._pth" a
    FileSeek $1 0 END
    FileWrite $1 "..\site-packages$\r$\n"
    FileWrite $1 "..$\r$\n"
    FileClose $1
    FileOpen $1 "$INSTDIR\buildbot-py\python\python312._pth" a
    FileSeek $1 0 END
    FileWrite $1 "..\site-packages$\r$\n"
    FileClose $1
    ; git is not bundled: default backend is Dulwich (no executable);
    ; TO_GIT_BACKEND=cli needs a separately installed Git.
    nsExec::ExecToLog 'cmd /c ""$INSTDIR\python\python.exe" -m testorchestrator db-upgrade >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Database migration failed (code $0) — see $DATA_DIR\logs\install.log"
        Abort "db-upgrade failed"
    ${EndIf}

    ; Buildbot provisioning: master.cfg/secrets.json/targets.json +
    ; create-master/upgrade-master/create-worker basedirs under
    ; $DATA_DIR\buildbot. Credential-preserving on rerun
    ; (provision_buildbot reuses secrets.json). --no-units: Scheduled
    ; Tasks below replace systemd on this platform.
    nsExec::ExecToLog 'cmd /c ""$INSTDIR\python\python.exe" "$INSTDIR\scripts\provision_buildbot.py" --home "$DATA_DIR\buildbot" --python "$INSTDIR\buildbot-py\python\python.exe" --repo-root "$INSTDIR" --setup --no-units >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Buildbot provisioning failed (code $0) — see $DATA_DIR\logs\install.log"
        Abort "provision_buildbot failed"
    ${EndIf}

    ; task-friendly launchers: Task Scheduler sets no env, working
    ; directory, or stdout capture — wrap each service in a .cmd that
    ; appends output to $DATA_DIR\logs (the journald equivalent).
    ; HOME/USERPROFILE are pinned so SYSTEM-context subprocesses
    ; (git/ssh/KRE) have a deterministic writable home.
    FileOpen $0 "$DATA_DIR\run_web.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'set "HOME=$DATA_DIR\home"$\r$\n'
    FileWrite $0 'set "USERPROFILE=$DATA_DIR\home"$\r$\n'
    FileWrite $0 '"$INSTDIR\python\python.exe" -u "$INSTDIR\wsgi.py" >> "$DATA_DIR\logs\web.log" 2>&1$\r$\n'
    FileClose $0
    FileOpen $0 "$DATA_DIR\run_worker.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'set "HOME=$DATA_DIR\home"$\r$\n'
    FileWrite $0 'set "USERPROFILE=$DATA_DIR\home"$\r$\n'
    FileWrite $0 '"$INSTDIR\python\python.exe" -u "$INSTDIR\run_worker.py" >> "$DATA_DIR\logs\worker.log" 2>&1$\r$\n'
    FileClose $0
    ; embeddable Python ships no console scripts — invoke the buildbot
    ; entry points through `python -c`; sys.argv[1:] carries the real
    ; subcommand and arguments.
    FileOpen $0 "$DATA_DIR\run_bbmaster.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 '"$INSTDIR\buildbot-py\python\python.exe" -u -c "from buildbot.scripts.runner import run; run()" start --nodaemon "$DATA_DIR\buildbot\master" >> "$DATA_DIR\logs\bb-master.log" 2>&1$\r$\n'
    FileClose $0
    FileOpen $0 "$DATA_DIR\run_bblocal.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'set "HOME=$DATA_DIR\home"$\r$\n'
    FileWrite $0 '"$INSTDIR\buildbot-py\python\python.exe" -u -c "from buildbot_worker.scripts.runner import run; run()" start --nodaemon "$DATA_DIR\buildbot\local" >> "$DATA_DIR\logs\bb-local.log" 2>&1$\r$\n'
    FileClose $0
    FileOpen $0 "$DATA_DIR\run_bbssh.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'set "HOME=$DATA_DIR\home"$\r$\n'
    FileWrite $0 '"$INSTDIR\buildbot-py\python\python.exe" -u -c "from buildbot_worker.scripts.runner import run; run()" start --nodaemon "$DATA_DIR\buildbot\dispatcher" >> "$DATA_DIR\logs\bb-ssh.log" 2>&1$\r$\n'
    FileClose $0
    ; supported stop: end the tasks AND reap orphaned children —
    ; schtasks /End alone kills only the .cmd host and leaves the
    ; python children bound to their ports
    FileOpen $0 "$DATA_DIR\stop_to.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'schtasks /End /TN "TestOrchestratorWeb"$\r$\n'
    FileWrite $0 'schtasks /End /TN "TestOrchestratorWorker"$\r$\n'
    FileWrite $0 'schtasks /End /TN "TestOrchestratorBuildbotMaster"$\r$\n'
    FileWrite $0 'schtasks /End /TN "TestOrchestratorBuildbotLocal"$\r$\n'
    FileWrite $0 'schtasks /End /TN "TestOrchestratorBuildbotSSH"$\r$\n'
    FileWrite $0 "powershell -NoProfile -Command $\"$$ps = Get-CimInstance Win32_Process | Where-Object { $$_.CommandLine -and $$_.CommandLine.IndexOf('$INSTDIR',[StringComparison]::OrdinalIgnoreCase) -ge 0 }; $$ps | ForEach-Object { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }; $$ps | ForEach-Object { Wait-Process -Id $$_.ProcessId -Timeout 20 -ErrorAction SilentlyContinue }$\"$\r$\n"
    FileClose $0
    ; uninstall helper: untrust this installation's root CA by thumbprint
    ; (the CA is unique per install — never a shared/distributed key)
    ; supported headless uninstall — self-contained: the NSIS silent
    ; uninstaller (temp-copy or _?=) silently no-ops in headless/Session-0
    ; contexts, so the wrapper performs the same steps deterministically.
    ; It first self-relocates to %TEMP%: PURGE must delete $DATA_DIR,
    ; which cannot be removed while the running .cmd lives inside it —
    ; the temp copy then purges synchronously (detached 'start' is not
    ; reliable in headless/Session-0 contexts).
    ; Interactive uninstall via uninstall.exe / Add-Remove remains the
    ; desktop path.
    FileOpen $0 "$DATA_DIR\uninstall_to.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 'if "%~1"=="/IN-TEMP" goto :run$\r$\n'
    FileWrite $0 'copy /y "%~f0" "%TEMP%\to-uninstall.cmd" >nul$\r$\n'
    FileWrite $0 '"%TEMP%\to-uninstall.cmd" /IN-TEMP %*$\r$\n'
    FileWrite $0 "exit /b$\r$\n"
    FileWrite $0 ":run$\r$\n"
    FileWrite $0 'call "$DATA_DIR\untrust_ca.cmd"$\r$\n'
    FileWrite $0 'call "$DATA_DIR\stop_to.cmd"$\r$\n'
    FileWrite $0 'schtasks /Delete /TN "TestOrchestratorWeb" /F$\r$\n'
    FileWrite $0 'schtasks /Delete /TN "TestOrchestratorWorker" /F$\r$\n'
    FileWrite $0 'schtasks /Delete /TN "TestOrchestratorBuildbotMaster" /F$\r$\n'
    FileWrite $0 'schtasks /Delete /TN "TestOrchestratorBuildbotLocal" /F$\r$\n'
    FileWrite $0 'schtasks /Delete /TN "TestOrchestratorBuildbotSSH" /F$\r$\n'
    FileWrite $0 'reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" /f >nul 2>&1$\r$\n'
    FileWrite $0 'rmdir /s /q "$INSTDIR"$\r$\n'
    FileWrite $0 'echo %* | findstr /i /c:"/PURGE" >nul && rmdir /s /q "$DATA_DIR"$\r$\n'
    FileWrite $0 "exit /b 0$\r$\n"
    FileClose $0
    FileOpen $0 "$DATA_DIR\untrust_ca.cmd" w
    FileWrite $0 "@echo off$\r$\n"
    FileWrite $0 "powershell -NoProfile -Command $\"if(Test-Path '$DATA_DIR\certs\local-ca.pem'){$$t=(New-Object System.Security.Cryptography.X509Certificates.X509Certificate2('$DATA_DIR\certs\local-ca.pem')).Thumbprint; Remove-Item -Path ('HKLM:\SOFTWARE\Microsoft\SystemCertificates\Root\Certificates\'+$$t) -Recurse -Force -ErrorAction SilentlyContinue}$\"$\r$\n"
    FileClose $0

    ; scheduled tasks for web + dispatch worker + buildbot master +
    ; local worker + ssh dispatcher (start at boot) — failures are
    ; logged + surfaced, never silently dropped
    nsExec::ExecToLog 'cmd /c "schtasks /Create /TN "TestOrchestratorWeb" /SC ONSTART /RU SYSTEM /RL HIGHEST /F /TR "\"$DATA_DIR\run_web.cmd\"" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Scheduled-task registration failed for TestOrchestratorWeb (code $0) — see $DATA_DIR\logs\install.log"
    ${EndIf}
    nsExec::ExecToLog 'cmd /c "schtasks /Create /TN "TestOrchestratorWorker" /SC ONSTART /RU SYSTEM /RL HIGHEST /F /TR "\"$DATA_DIR\run_worker.cmd\"" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Scheduled-task registration failed for TestOrchestratorWorker (code $0) — see $DATA_DIR\logs\install.log"
    ${EndIf}
    nsExec::ExecToLog 'cmd /c "schtasks /Create /TN "TestOrchestratorBuildbotMaster" /SC ONSTART /RU SYSTEM /RL HIGHEST /F /TR "\"$DATA_DIR\run_bbmaster.cmd\"" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Scheduled-task registration failed for TestOrchestratorBuildbotMaster (code $0) — see $DATA_DIR\logs\install.log"
    ${EndIf}
    nsExec::ExecToLog 'cmd /c "schtasks /Create /TN "TestOrchestratorBuildbotLocal" /SC ONSTART /RU SYSTEM /RL HIGHEST /F /TR "\"$DATA_DIR\run_bblocal.cmd\"" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Scheduled-task registration failed for TestOrchestratorBuildbotLocal (code $0) — see $DATA_DIR\logs\install.log"
    ${EndIf}
    nsExec::ExecToLog 'cmd /c "schtasks /Create /TN "TestOrchestratorBuildbotSSH" /SC ONSTART /RU SYSTEM /RL HIGHEST /F /TR "\"$DATA_DIR\run_bbssh.cmd\"" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    ${If} $0 != "0"
        MessageBox MB_ICONEXCLAMATION "Scheduled-task registration failed for TestOrchestratorBuildbotSSH (code $0) — see $DATA_DIR\logs\install.log"
    ${EndIf}

    ; start now — the app is usable immediately after install,
    ; no reboot required
    nsExec::ExecToLog 'cmd /c "schtasks /Run /TN "TestOrchestratorBuildbotMaster" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    nsExec::ExecToLog 'cmd /c "schtasks /Run /TN "TestOrchestratorBuildbotLocal" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    nsExec::ExecToLog 'cmd /c "schtasks /Run /TN "TestOrchestratorBuildbotSSH" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    nsExec::ExecToLog 'cmd /c "schtasks /Run /TN "TestOrchestratorWeb" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0
    nsExec::ExecToLog 'cmd /c "schtasks /Run /TN "TestOrchestratorWorker" >> "$DATA_DIR\logs\install.log" 2>&1"'
    Pop $0

    ; Trust this installation's generated root CA in the LocalMachine
    ; store so client browsers accept https://localhost without
    ; certificate-error bypasses. The CA is generated fresh per
    ; installation by the portal on first boot — no private CA key is
    ; distributed in or shared across packages.
    StrCpy $2 0
    ${Do}
        ${If} ${FileExists} "$DATA_DIR\certs\local-ca.pem"
            ${ExitDo}
        ${EndIf}
        IntOp $2 $2 + 1
        ${If} $2 >= 60
            ${ExitDo}
        ${EndIf}
        Sleep 1000
    ${Loop}
    StrCpy $3 ""
    ${IfNot} ${FileExists} "$DATA_DIR\certs\local-ca.pem"
        StrCpy $3 "the portal did not generate its local CA within 60s"
    ${Else}
        nsExec::ExecToLog 'certutil -addstore -f Root "$DATA_DIR\certs\local-ca.pem"'
        Pop $0
        ${If} $0 != 0
            StrCpy $3 "certutil -addstore Root exited $0"
        ${EndIf}
    ${EndIf}
    ${If} $3 != ""
        DetailPrint "Certificate trust NOT configured: $3"
        FileOpen $0 "$DATA_DIR\CERT-TRUST-NOT-INSTALLED.txt" w
        FileWrite $0 "Automatic HTTPS trust failed: $3$\r$\n$\r$\nBrowsers will warn on https://localhost until the generated$\r$\nroot CA is trusted manually:$\r$\n  certutil -addstore -f Root $\"$DATA_DIR\certs\local-ca.pem$\"$\r$\n"
        FileClose $0
        ${IfNot} ${Silent}
            MessageBox MB_ICONEXCLAMATION|MB_OK "HTTPS certificate trust was not configured ($3).$\r$\n$\r$\nSee $DATA_DIR\CERT-TRUST-NOT-INSTALLED.txt for the manual step."
        ${EndIf}
    ${EndIf}

    WriteUninstaller "$INSTDIR\uninstall.exe"
    ; NSIS is 32-bit: without SetRegView, HKLM\SOFTWARE writes land in
    ; WOW6432Node — register ARP in the native 64-bit view
    SetRegView 64
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "DisplayName" "${PRODUCT} ${VERSION}"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "DisplayVersion" "${VERSION}"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "Publisher" "IT-Space"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "DisplayIcon" "$INSTDIR\it.ico"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "NoRepair" 1
    ; interactive desktop flow — pending real-host validation (quoted:
    ; $INSTDIR may contain spaces)
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "UninstallString" '"$INSTDIR\uninstall.exe"'
    ; silent/scripted flow — deterministic wrapper (data retained; /PURGE
    ; is an explicit admin choice, not a quiet default)
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator" "QuietUninstallString" 'cmd /c "$DATA_DIR\uninstall_to.cmd"'
SectionEnd

Function OpenPortal
    ; finish-page "open in browser" — the configured public address
    ; (localhost by default) so the generated cert matches the URL.
    ExecShell "open" "https://$PUBLIC_ADDR:$ORCH_PORT/"
FunctionEnd

Function un.onInit
    ; $DATA_DIR is a runtime variable — it is NOT carried over from the
    ; install process; re-derive it so untrust/RMDir act on real paths.
    SetRegView 64
    ReadEnvStr $DATA_DIR "ProgramData"
    StrCpy $DATA_DIR "$DATA_DIR\TestOrchestrator"
    StrCpy $PURGE_DATA "0"
    ${un.GetOptions} $CMDLINE "/PURGEDATA=" $PURGE_DATA
FunctionEnd

Section "Uninstall"
    ; remove this installation's root CA from the machine trust store —
    ; without this a deleted private CA would leave a stale trust entry
    nsExec::ExecToLog '"$DATA_DIR\untrust_ca.cmd"'
    Pop $0
    nsExec::ExecToLog '"$DATA_DIR\stop_to.cmd"'
    Pop $0
    ; give killed children a beat to release file locks before RMDir
    Sleep 1500
    nsExec::ExecToLog 'schtasks /Delete /TN "TestOrchestratorWeb" /F'
    nsExec::ExecToLog 'schtasks /Delete /TN "TestOrchestratorWorker" /F'
    nsExec::ExecToLog 'schtasks /Delete /TN "TestOrchestratorBuildbotMaster" /F'
    nsExec::ExecToLog 'schtasks /Delete /TN "TestOrchestratorBuildbotLocal" /F'
    nsExec::ExecToLog 'schtasks /Delete /TN "TestOrchestratorBuildbotSSH" /F'
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\TestOrchestrator"
    RMDir /r "$INSTDIR"
    ${If} $PURGE_DATA == "1"
        RMDir /r "$DATA_DIR"
    ${Else}
        MessageBox MB_YESNO "Also delete configuration, database, and workspaces in $DATA_DIR?" /SD IDNO IDNO keepData
            RMDir /r "$DATA_DIR"
        keepData:
    ${EndIf}
SectionEnd
